{
  "name": "serializer-conformance",
  "version": "0.4.0",
  "description": "A conformance and collision harness for JavaScript value serializers: JSON canonicalizers and structural hashers. Byte-exact RFC 8785 (JCS) conformance against the official test vectors, plus the checks that matter more in practice: a collision detector for distinct inputs that produce identical output, a determinism check that catches implementations keyed on object identity rather than content, a type-coverage matrix over the whole JavaScript value graph, and a nesting-depth probe. Adapters for the popular npm packages, and bring-your-own.",
  "author": {
    "name": "David Estevez",
    "email": "dev.destbreso@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "serializer-conformance": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "canonicalization",
    "canonical-json",
    "jcs",
    "rfc8785",
    "conformance",
    "test-vectors",
    "harness",
    "benchmark",
    "structural-hash",
    "content-hash",
    "content-addressing",
    "collision",
    "differential-testing",
    "deterministic",
    "stable-stringify",
    "cli",
    "typescript",
    "json-canonicalization",
    "canonicalize",
    "test-suite",
    "serializer",
    "stringify",
    "identity"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "canonicalize": "^3.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "json-canonicalize": "^2.0.0",
    "object-hash": "^3.0.0",
    "ohash": "^2.0.11",
    "safe-stable-stringify": "^2.5.0",
    "stable-hash": "^0.0.6",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "picocolors": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/destbreso/serializer-conformance.git"
  },
  "homepage": "https://github.com/destbreso/serializer-conformance#readme",
  "bugs": {
    "url": "https://github.com/destbreso/serializer-conformance/issues"
  }
}
